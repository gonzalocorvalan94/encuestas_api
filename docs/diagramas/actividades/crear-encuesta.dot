digraph CreacionEncuesta {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#f5f5f5"];
    edge [fontname="Helvetica"];

    inicio [shape=circle, style=filled, fillcolor=black, label="", width=0.3];
    fin [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.3];

    subgraph cluster_admin {
        label="Administrador";
        style=dashed;
        seleccionar [label="Seleccionar\n\"Crear nueva encuesta\""];
        titulo [label="Ingresar título\ny descripción"];
        pregunta [label="Ingresar texto\nde la pregunta"];
        opciones [label="Agregar opciones\nde respuesta (mín. 2)"];
        mas [label="¿Agregar\notra pregunta?", shape=diamond, fillcolor="#fff2cc"];
        publicar [label="Publicar la encuesta"];
    }

    subgraph cluster_sistema {
        label="Sistema";
        style=dashed;
        enlace [label="Generar enlace único\npara compartir"];
    }

    inicio -> seleccionar;
    seleccionar -> titulo;
    titulo -> pregunta;
    pregunta -> opciones;
    opciones -> mas;
    mas -> pregunta [label="sí"];
    mas -> publicar [label="no"];
    publicar -> enlace;
    enlace -> fin;
}
