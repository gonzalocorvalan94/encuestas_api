digraph DFD {
    rankdir=LR;
    node [fontname="Arial"];

    usuario [
        label="USUARIO CREADOR",
        shape=box
    ];

    participante [
        label="PARTICIPANTE",
        shape=box
    ];

    empresa [
        label="EMPRESA",
        shape=box
    ];

    sistema [
        label="SISTEMA",
        shape=box
    ];

    datos [
        label="Datos encuesta",
        shape=note
    ];

    enlace [
        label="Enlace encuesta",
        shape=note
    ];

    respuestas [
        label="Respuestas enviadas",
        shape=note
    ];

    confirmacion [
        label="Confirmación",
        shape=note
    ];

    solicitud [
        label="Solicitud reporte",
        shape=note
    ];

    resultados [
        label="Resultados encuesta",
        shape=note
    ];

    procesar [
        label="Procesar respuestas",
        shape=ellipse
    ];

    usuario -> datos;
    datos -> sistema;

    sistema -> enlace;
    enlace -> participante;

    participante -> respuestas;
    respuestas -> sistema;

    sistema -> confirmacion;
    confirmacion -> participante;

    empresa -> solicitud;
    solicitud -> sistema;

    sistema -> procesar;
    procesar -> resultados;
    resultados -> empresa;
}
