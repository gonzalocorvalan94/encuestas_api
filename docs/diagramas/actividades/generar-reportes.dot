digraph GeneracionReportes {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#f5f5f5"];
    edge [fontname="Helvetica"];

    inicio [shape=circle, style=filled, fillcolor=black, label="", width=0.3];
    fin [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.3];

    subgraph cluster_admin {
        label="Administrador";
        style=dashed;
        seleccionar [label="Seleccionar encuesta\ncerrada"];
    }

    subgraph cluster_sistema {
        label="Sistema";
        style=dashed;
        consultar [label="Consultar respuestas\nalmacenadas"];
        calcular [label="Calcular por pregunta:\ntotal, conteo por opción\ny porcentaje"];
        presentar [label="Presentar resultados\n(tabla y/o gráfico)"];
    }

    inicio -> seleccionar;
    seleccionar -> consultar;
    consultar -> calcular;
    calcular -> presentar;
    presentar -> fin;
}
